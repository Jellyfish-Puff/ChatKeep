<Window x:Class="ChatArchive.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="Assets/chat-archive.ico" Title="聊存 ChatKeep" Width="1380" Height="900" MinWidth="960" MinHeight="640" FontFamily="Microsoft YaHei UI" FontSize="14" Background="#FFFFFF" Closing="WindowClosing">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="MainWindowStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
<Grid Background="#FFFFFF"><Grid.ColumnDefinitions><ColumnDefinition Width="176"/><ColumnDefinition Width="*" MinWidth="220" MaxWidth="322"/><ColumnDefinition Width="2.5*"/></Grid.ColumnDefinitions>
  <Border Background="#F7F9F8" BorderBrush="#E1E7E3" BorderThickness="0,0,1,0"><DockPanel Margin="16,24">
    <StackPanel DockPanel.Dock="Top"><TextBlock Text="聊存 ChatKeep" FontSize="19" FontWeight="SemiBold" Margin="8,0,0,8"/><TextBlock Text="本地聊天，轻松保存" Foreground="#617369" FontSize="12" Margin="8,0,0,32"/><Button Content="聊天记录" Background="#E1F1E9" Foreground="#087F65" BorderBrush="#E1F1E9" HorizontalContentAlignment="Left"/><Button Content="打开导出文件夹" Click="OpenExports" Margin="4,12,4,4"/></StackPanel>
    <StackPanel VerticalAlignment="Bottom"><TextBlock x:Name="Status" Text="尚未连接微信" TextWrapping="Wrap" Foreground="#52665B" FontSize="12" Margin="8"/><Button x:Name="ConnectButton" Content="连接微信" Click="ConnectClick" Background="{StaticResource Green}" Foreground="White"/><TextBlock Text="只读取电脑本地记录" FontSize="11" Foreground="#617369" Margin="8,12,0,0"/></StackPanel>
  </DockPanel></Border>
  <Border Grid.Column="1" BorderBrush="#E1E7E3" BorderThickness="0,0,1,0"><DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="20,24,20,16"><DockPanel><Button x:Name="BatchExportButton" Content="批量导出" DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="12,7" Margin="8,0,0,0" IsEnabled="False" Click="BatchExportClick"/><TextBlock Text="群聊" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock x:Name="GroupCount" Text="连接后选择一个群聊" Foreground="#617369" FontSize="12" Margin="0,6,0,18"/><TextBox x:Name="Search" Style="{StaticResource RoundedSearchBox}" TextChanged="SearchChanged" AutomationProperties.Name="搜索群聊" ToolTip="搜索群聊"/></StackPanel>
    <ListBox x:Name="ChatList" BorderThickness="0" Background="White" ItemContainerStyle="{StaticResource RoundedChatItem}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ChatChanged"><ListBox.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource SlimVerticalScrollBar}"/></ListBox.Resources><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="38" Height="38" CornerRadius="9" Background="#E6F0EB" VerticalAlignment="Top"><TextBlock Text="群" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#087F65" FontSize="16"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Summary}" Foreground="#617369" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
  </DockPanel></Border>
  <Grid Grid.Column="2" Background="#F5F7F6"><Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="White" BorderBrush="#E1E7E3" BorderThickness="0,0,0,1">
      <Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="2.8*" MinWidth="380" MaxWidth="416"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="ChatTitle" Text="选择一个群聊" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
          <TextBlock Text="浏览消息 · 按日期或勾选导出" Foreground="#617369" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Grid x:Name="MessageToolbar" Grid.Column="2" VerticalAlignment="Center">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid Margin="0,0,8,0">
            <TextBox x:Name="MessageSearch" Tag="在此群聊中搜索" Style="{StaticResource RoundedSearchBox}" Height="36" Padding="0,0,22,0" MaxLength="256"
                     IsEnabled="False" KeyDown="MessageSearchKeyDown" TextChanged="MessageSearchTextChanged" AutomationProperties.Name="在此群聊中搜索" ToolTip="搜索当前群聊的全部本地文字和卡片，按回车执行"/>
            <Button x:Name="ClearMessageSearchButton" Content="×" Width="22" Height="24" Padding="0" Margin="0,0,7,0" BorderBrush="Transparent" Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Right" Click="ClearMessageSearch" ToolTip="清空搜索，返回聊天" AutomationProperties.Name="清空会话搜索">
              <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=MessageSearch}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
            </Button>
          </Grid>
          <ToggleButton x:Name="SelectionMode" Grid.Column="1" Content="选择" Style="{StaticResource SelectionToggle}" Margin="0,0,8,0" IsEnabled="False" Click="SelectionChanged" ToolTip="进入选择模式；再次点击退出并清空勾选"/>
          <Button x:Name="ExportButton" Grid.Column="2" Content="导出 HTML" Width="100" Height="36" Margin="0" Padding="12,0" Click="ExportClick" IsEnabled="False"/>
        </Grid>
      </Grid>
    </Border>
    <TextBlock x:Name="Notice" Grid.Row="1" TextWrapping="Wrap" Margin="24,14" Foreground="#52665B" Text="连接微信后，在中间列表选择群聊。"/>
    <ScrollViewer x:Name="MessagesScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource SlimVerticalScrollBar}"/></ScrollViewer.Resources><StackPanel x:Name="MessagePanel" Margin="24,0,24,24"/></ScrollViewer>
    <Border Grid.Row="3" Background="White" BorderBrush="#E1E7E3" BorderThickness="0,1,0,0"><DockPanel Margin="20,10"><Button x:Name="OlderButton" Content="加载更早的消息" DockPanel.Dock="Left" IsEnabled="False" Click="OlderClick"/><TextBlock x:Name="SelectionCount" Text="未选择消息" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#617369"/></DockPanel></Border>
  </Grid>
</Grid></Window>
