<Window x:Class="ChatArchive.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="Assets/chat-archive.ico" Title="聊存 ChatKeep" Width="1380" Height="900" MinWidth="1024" MinHeight="640" FontFamily="Microsoft YaHei UI" FontSize="14" Background="#FFFFFF" Closing="WindowClosing">
<Grid Background="#FFFFFF"><Grid.ColumnDefinitions><ColumnDefinition Width="176"/><ColumnDefinition Width="322"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#F7F9F8" BorderBrush="#E1E7E3" BorderThickness="0,0,1,0"><DockPanel Margin="16,24">
    <StackPanel DockPanel.Dock="Top"><TextBlock Text="聊存 ChatKeep" FontSize="19" FontWeight="SemiBold" Margin="8,0,0,8"/><TextBlock Text="本地聊天，轻松保存" Foreground="#617369" FontSize="12" Margin="8,0,0,32"/><Button Content="聊天记录" Background="#E1F1E9" Foreground="#087F65" BorderBrush="#E1F1E9" HorizontalContentAlignment="Left"/><Button Content="打开导出文件夹" Click="OpenExports" Margin="4,12,4,4"/></StackPanel>
    <StackPanel VerticalAlignment="Bottom"><TextBlock x:Name="Status" Text="尚未连接微信" TextWrapping="Wrap" Foreground="#52665B" FontSize="12" Margin="8"/><Button x:Name="ConnectButton" Content="连接微信" Click="ConnectClick" Background="{StaticResource Green}" Foreground="White"/><TextBlock Text="只读取电脑本地记录" FontSize="11" Foreground="#617369" Margin="8,12,0,0"/></StackPanel>
  </DockPanel></Border>
  <Border Grid.Column="1" BorderBrush="#E1E7E3" BorderThickness="0,0,1,0"><DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="20,24,20,16"><DockPanel><Button x:Name="BatchExportButton" Content="批量导出" DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="12,7" Margin="8,0,0,0" IsEnabled="False" Click="BatchExportClick"/><TextBlock Text="群聊" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock x:Name="GroupCount" Text="连接后选择一个群聊" Foreground="#617369" FontSize="12" Margin="0,6,0,18"/><TextBox x:Name="Search" TextChanged="SearchChanged" AutomationProperties.Name="搜索群聊" ToolTip="搜索群聊"/></StackPanel>
    <ListBox x:Name="ChatList" BorderThickness="0" Background="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ChatChanged"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="14,15"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="38" Height="38" CornerRadius="9" Background="#E6F0EB" VerticalAlignment="Top"><TextBlock Text="群" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#087F65" FontSize="16"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Summary}" Foreground="#617369" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
  </DockPanel></Border>
  <Grid Grid.Column="2" Background="#F5F7F6"><Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="White" BorderBrush="#E1E7E3" BorderThickness="0,0,0,1"><Grid Margin="24,0"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="ChatTitle" Text="选择一个群聊" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="浏览消息 · 按日期或勾选导出" Foreground="#617369" FontSize="12" Margin="0,5,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><CheckBox x:Name="SelectionMode" Content="勾选消息" VerticalAlignment="Center" Margin="8" Click="SelectionChanged"/><Button x:Name="ExportButton" Content="导出聊天记录" Click="ExportClick" Background="{StaticResource Green}" Foreground="White" IsEnabled="False"/></StackPanel></Grid></Border>
    <TextBlock x:Name="Notice" Grid.Row="1" TextWrapping="Wrap" Margin="24,14" Foreground="#52665B" Text="连接微信后，在中间列表选择群聊。"/>
    <ScrollViewer x:Name="MessagesScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="MessagePanel" Margin="24,0,24,24"/></ScrollViewer>
    <Border Grid.Row="3" Background="White" BorderBrush="#E1E7E3" BorderThickness="0,1,0,0"><DockPanel Margin="20,10"><Button x:Name="OlderButton" Content="加载更早的消息" DockPanel.Dock="Left" IsEnabled="False" Click="OlderClick"/><TextBlock x:Name="SelectionCount" Text="未选择消息" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#617369"/></DockPanel></Border>
  </Grid>
</Grid></Window>
