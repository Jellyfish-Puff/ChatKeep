<Window x:Class="ChatArchive.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出聊天记录" Width="720" Height="372" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="White" FontFamily="Microsoft YaHei UI" FontSize="13">
  <Window.Resources>
    <Style TargetType="DatePickerTextBox">
      <Setter Property="Foreground" Value="#25372F"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DatePickerTextBox">
            <Grid Margin="8,0,0,0">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
              <TextBlock x:Name="DateHint" Text="年/月/日" Foreground="#87958D" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers><Trigger Property="Text" Value=""><Setter TargetName="DateHint" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DatePicker">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DatePicker">
            <Grid x:Name="PART_Root" Background="Transparent">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
              <DatePickerTextBox x:Name="PART_TextBox" BorderThickness="0" Background="Transparent"/>
              <Button x:Name="PART_Button" Grid.Column="1" Focusable="False" Margin="0" Padding="0" ToolTip="选择日期" AutomationProperties.Name="打开日历">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="CalendarFrame" Background="Transparent" CornerRadius="5" Margin="2">
                      <Viewbox Width="16" Height="16">
                        <Canvas Width="20" Height="20">
                          <Rectangle Canvas.Left="3" Canvas.Top="4" Width="14" Height="13" RadiusX="2" RadiusY="2" Stroke="#617369" StrokeThickness="1.4"/>
                          <Path Data="M 3 8 L 17 8 M 7 2 L 7 6 M 13 2 L 13 6 M 7 11 L 9 11 M 11 11 L 13 11 M 7 14 L 9 14" Stroke="#617369" StrokeThickness="1.4"/>
                        </Canvas>
                      </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CalendarFrame" Property="Background" Value="#E1F1E9"/></Trigger></ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
              <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" StaysOpen="False" AllowsTransparency="True"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ExportCombo" TargetType="ComboBox">
      <Setter Property="Height" Value="36"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#D9E2DD"/>
      <Setter Property="Foreground" Value="#25372F"/>
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="FieldToggle" Focusable="False" ClickMode="Press" BorderBrush="{TemplateBinding BorderBrush}"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="FieldFrame" CornerRadius="7" Background="White" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                      <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#617369" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FieldFrame" Property="BorderBrush" Value="#A7BFB4"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                Margin="12,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="White" CornerRadius="7" BorderBrush="#D9E2DD" BorderThickness="1" Padding="4"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FieldToggle" Property="BorderBrush" Value="#087F65"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="9,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                  <Border x:Name="OptionFrame" CornerRadius="5" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="OptionFrame" Property="Background" Value="#F1F4F3"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="OptionFrame" Property="Background" Value="#E1F1E9"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FieldLabel" TargetType="Label">
      <Setter Property="Foreground" Value="#718077"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="0"/>
    </Style>
  </Window.Resources>
  <Grid Margin="24,20,24,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="导出聊天记录" FontSize="18" FontWeight="SemiBold" Foreground="#25372F"/>
      <TextBlock x:Name="ChatName" Grid.Column="2" Foreground="#87958D" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="10"/><RowDefinition Height="36"/><RowDefinition Height="10"/><RowDefinition Height="36"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Label Content="日期范围" Target="{Binding ElementName=StartPicker}" Style="{StaticResource FieldLabel}"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Border Width="164" Height="36" CornerRadius="7" BorderBrush="#D9E2DD" BorderThickness="1">
          <DatePicker x:Name="StartPicker" BorderThickness="0" Background="Transparent" Padding="4,2" VerticalContentAlignment="Center" SelectedDateFormat="Short" AutomationProperties.Name="开始日期"/>
        </Border>
        <TextBlock Text="至" Width="28" TextAlignment="Center" VerticalAlignment="Center" Foreground="#87958D"/>
        <Border Width="164" Height="36" CornerRadius="7" BorderBrush="#D9E2DD" BorderThickness="1">
          <DatePicker x:Name="EndPicker" BorderThickness="0" Background="Transparent" Padding="4,2" VerticalContentAlignment="Center" SelectedDateFormat="Short" AutomationProperties.Name="结束日期，包含当天全天"/>
        </Border>
        <Button x:Name="ClearDatesButton" Content="清空" Margin="8,0,0,0" Padding="12,0" Click="ClearDates" ToolTip="清空后重新选择日期范围"/>
      </StackPanel>
      <Label Grid.Row="2" Content="导出内容" Target="{Binding ElementName=ContentPicker}" Style="{StaticResource FieldLabel}"/>
      <ComboBox x:Name="ContentPicker" Grid.Row="2" Grid.Column="1" Width="268" HorizontalAlignment="Left" Style="{StaticResource ExportCombo}" SelectionChanged="ContentChanged" AutomationProperties.Name="导出内容">
        <ComboBoxItem Content="日期范围内全部记录"/><ComboBoxItem x:Name="SelectedContent" Content="已勾选的消息"/>
      </ComboBox>
      <Label Grid.Row="4" Content="格式" Target="{Binding ElementName=FormatPicker}" Style="{StaticResource FieldLabel}"/>
      <ComboBox x:Name="FormatPicker" Grid.Row="4" Grid.Column="1" Width="342" HorizontalAlignment="Left" Style="{StaticResource ExportCombo}" SelectedIndex="0" AutomationProperties.Name="导出格式">
        <ComboBoxItem Content="HTML（含图片，双击即可浏览）"/>
      </ComboBox>
      <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,10,0,0">
        <TextBlock x:Name="Summary" Foreground="#87958D" FontSize="12"/>
        <TextBlock x:Name="Hint" Foreground="#87958D" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
        <TextBlock Text="结束日期包含当天全天。" Foreground="#87958D" FontSize="12" Margin="0,4,0,0"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="4" Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="Error" Foreground="#B34335" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" AutomationProperties.LiveSetting="Polite"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="取消" IsCancel="True" Margin="0,0,8,0" Padding="16,8"/>
        <Button x:Name="StartExportButton" Content="开始导出" IsDefault="True" Background="#087F65" Foreground="White" Margin="0" Padding="18,8" Click="StartExport"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
